NODE_ENV=development
DATABASE_URL=
REDIS_URL=
LOG_LEVEL=info
WORKER_CONCURRENCY=2
SHUTDOWN_TIMEOUT_MS=10000

# Independent 32-byte key, identical on API and outbox worker. No automatic rotation.
EMAIL_VERIFICATION_KEY_ID=v1
EMAIL_VERIFICATION_KEY=
# Development Mailpit; production requires authenticated HTTPS and a reviewed relay.
EMAIL_MAIL_ENDPOINT=http://127.0.0.1:8025/api/v1/send
EMAIL_MAIL_FROM=verification@unblok.local
EMAIL_MAIL_USERNAME=
EMAIL_MAIL_PASSWORD=
