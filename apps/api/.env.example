NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=65536
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
# Required: independently generated signing secret, 32-64 random bytes as hex.
# Never reuse a database/Valkey password. Comma-separated previous keys optional.
SESSION_SECRETS=
# Change namespace AND signing keys when recovering a rolled-back auth database.
SESSION_NAMESPACE=v1
SESSION_TRUSTED_PROXIES=
SESSION_CROSS_ORIGIN=false
