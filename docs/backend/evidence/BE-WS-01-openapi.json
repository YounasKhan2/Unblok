              },
              "slug": {
                "type": "string",
                "maxLength": 63
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "ARCHIVED"
                ]
              },
              "membershipRole": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "MEMBER",
                  "OBSERVER"
                ]
              }
            },
            "required": [
              "id",
              "slug",
              "name",
              "status",
              "membershipRole"
            ],
            "additionalProperties": false
          },
          "initialAdministrator": {
            "type": "object",
            "properties": {
              "workspaceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "membershipId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "MEMBER",
                  "OBSERVER"
                ]
              },
              "membershipStatus": {
                "type": "string",
                "const": "ACTIVE"
              },
              "workspaceStatus": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "ARCHIVED"
