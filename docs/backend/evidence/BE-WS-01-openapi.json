                  "listMembers",
                  "inviteMembers",
                  "createTeam",
                  "writeIssues",
                  "writeDependencies",
                  "completeDependentIssues"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "workspaceId",
              "membershipId",
              "role",
              "membershipStatus",
              "workspaceStatus",
              "capabilities"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "workspace",
          "self"
        ],
        "additionalProperties": false
      },
