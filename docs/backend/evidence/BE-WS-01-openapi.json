                  "type": "string",
                  "enum": [
                    "ACTIVE",
                    "ARCHIVED"
                  ]
                },
                "membershipRole": {
                  "type": "string",
                  "enum": [
                    "ADMIN",
                    "MEMBER",
                    "OBSERVER"
                  ]
                }
              },
              "required": [
                "id",
                "slug",
                "name",
                "status",
                "membershipRole"
              ],
              "additionalProperties": false
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2048
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hasMore": {
                "type": "boolean"
              }
            },
            "required": [
              "nextCursor",
              "hasMore"
